# Caddy fronts the whole stack on the VM. Auto-issues Let's Encrypt for
# {$PUBLIC_DOMAIN} via the on-demand HTTP-01 challenge — port 80 must be
# reachable from the public internet for ACME to succeed.
#
# Routing:
#   - /api/*      -> api:8000 (strip /api prefix)
#   - /ws         -> api:8000 (websocket upgrade)
#   - /flow/*, /webhooks/*, /widget*, /lf/*, /healthz -> api:8000
#   - everything else -> web:80 (nginx serving the SPA)
{
    email {$ACME_EMAIL}
}

# Canonicalise on the apex so the session cookie (httponly, no Domain
# attribute → defaults to the host that set it) is sent on every request.
# Without this, signing in on the apex and then loading the SPA from www
# results in 401s on every authed call because the browser refuses to
# send a workspacx.com cookie to www.workspacx.com.
www.{$PUBLIC_DOMAIN} {
    redir https://{$PUBLIC_DOMAIN}{uri} permanent
}

{$PUBLIC_DOMAIN} {
    encode zstd gzip

    # api routes — strip the `/api` prefix so backend sees `/auth/...`,
    # `/conversations/...` etc.
    handle_path /api/* {
        reverse_proxy api:8000
    }

    # WebSocket — both the workspace `/ws` and the widget `/widget/ws`
    # paths upgrade in place; Caddy transparently proxies the upgrade.
    @ws path /ws /widget/ws
    handle @ws {
        reverse_proxy api:8000
    }

    # Other backend-served paths that the browser hits directly.
    # `/auth/oauth/*/callback` is critical: Google/Outlook redirect the
    # browser there with `?code=…` after consent, and the api needs to
    # complete the token exchange. Without it, Caddy 200s the SPA shell
    # (which has no client-side route for /auth/oauth/...) and the OAuth
    # flow appears to silently succeed in the URL bar but never finishes.
    @backend path /flow/* /webhooks/* /widget* /healthz /lf/* /auth/oauth/*
    handle @backend {
        reverse_proxy api:8000
    }

    # Everything else is the SPA.
    handle {
        reverse_proxy web:80
    }
}
