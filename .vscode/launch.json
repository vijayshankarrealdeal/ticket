{
  "version": "0.2.0",
  "configurations": [
    {
      // Brings up db / redis / minio / langflow via docker compose, then exits.
      // Use this when you only want the infra and plan to run the api/web
      // locally with hot-reload.
      "name": "Stack: Infra only (db, redis, minio, langflow)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose up -d db redis minio langflow && docker compose ps",
      "cwd": "${workspaceFolder}"
    },
    {
      // Full containerized stack — mirrors prod. Rebuilds images on change.
      "name": "Stack: Full (docker compose up --build)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose up --build",
      "cwd": "${workspaceFolder}"
    },
    {
      // FastAPI with uvicorn --reload. Runs against the infra started by
      // "Stack: Infra only". DB/Redis/MinIO point at localhost-exposed ports.
      "name": "Backend: FastAPI (uvicorn --reload)",
      "type": "debugpy",
      "request": "launch",
      "python": "/home/verti/miniconda3/bin/python",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host", "0.0.0.0",
        "--port", "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      // --reload forks a worker; track & kill it with the parent.
      "subProcess": true,
      "console": "integratedTerminal",
      // Pull secrets (LANGFLOW_SUPERUSER_PASSWORD, LANGFLOW_WEBHOOK_SECRET,
      // WORKSPACEX_SECRET_KEY, AZURE_*, Google Client_*) from the gitignored
      // `.env` at the repo root. Keeps creds out of this committed file. The
      // inline `env` below wins on conflict, so localhost-specific URLs still
      // override any host-ambiguous defaults the .env might carry.
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "APP_ROLE": "api",
        "PORT": "8000",
        "DATABASE_URL": "postgresql://workspacex:workspacex@localhost:5432/workspacex",
        "REDIS_URL": "redis://localhost:6379",
        "S3_ENDPOINT": "http://localhost:9000",
        "S3_PUBLIC_URL": "http://localhost:9000",
        "S3_BUCKET": "workspacex",
        "S3_ACCESS_KEY": "workspacex",
        "S3_SECRET_KEY": "workspacex-secret",
        // Host-mode dev: the api talks to Langflow over the docker-published
        // port, NOT the `langflow` internal DNS name. Public URL is identical
        // since the browser is on the same host.
        "LANGFLOW_URL": "http://localhost:7860",
        "LANGFLOW_PUBLIC_URL": "http://localhost:7860",
        "AUTO_MIGRATE": "1",
        "AUTO_SEED": "1",
        "CORS_ORIGINS": "http://localhost:3000,http://localhost:5173",
        "PYTHONUNBUFFERED": "1"
      },
      "justMyCode": false,
      "preLaunchTask": "backend: prelaunch",
      "postDebugTask": "port: free 8000"
    },
    {
      // Worker process (AI responder, SLA engine, outbox dispatcher stubs).
      "name": "Backend: Worker (app.worker)",
      "type": "debugpy",
      "request": "launch",
      "python": "/home/verti/miniconda3/bin/python",
      "module": "app.worker",
      "cwd": "${workspaceFolder}/backend",
      // Same envFile pattern as the api — secrets via `.env`, localhost
      // overrides inline. Without LANGFLOW_SUPERUSER_PASSWORD +
      // WORKSPACEX_SECRET_KEY the `_langflow_publish_poll_tick` can't
      // authenticate against Langflow, so the poll loop silently no-ops.
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "APP_ROLE": "worker",
        "DATABASE_URL": "postgresql://workspacex:workspacex@localhost:5432/workspacex",
        "REDIS_URL": "redis://localhost:6379",
        "S3_ENDPOINT": "http://localhost:9000",
        "LANGFLOW_URL": "http://localhost:7860",
        "LANGFLOW_PUBLIC_URL": "http://localhost:7860",
        "AUTO_MIGRATE": "0",
        "AUTO_SEED": "0",
        "PYTHONUNBUFFERED": "1"
      },
      "justMyCode": false,
      "preLaunchTask": "stack: up (infra only)"
    },
    {
      // Vite dev server with HMR on :5173. VITE_API_URL points the SPA at the
      // locally-running FastAPI (rather than the nginx-fronted /api path).
      "name": "Frontend: Vite dev (npm run dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "env": {
        "VITE_API_URL": "http://localhost:8000"
      },
      "preLaunchTask": "port: free 5173"
    },
    {
      // Opens Chrome against the Vite dev server for DOM/JS debugging.
      // Pair with "Frontend: Vite dev" via the compound below.
      "name": "Frontend: Chrome attach (localhost:5173)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      // One-click dev — nothing to start manually:
      //   * `backend: prelaunch` brings up db/redis/minio/langflow via docker
      //     compose (idempotent — no-op when containers are already healthy),
      //   * FastAPI launches under debugpy with --reload,
      //   * Background worker launches under debugpy too (SLA/outbox/langflow-
      //     poll loops), sharing the same `.env` for Langflow creds,
      //   * Vite starts the SPA on :5173 with HMR.
      // Secrets (LANGFLOW_SUPERUSER_PASSWORD, WORKSPACEX_SECRET_KEY, AZURE_*,
      // Client_*) flow in via `envFile: .env` on the backend/worker configs.
      "name": "Dev: Full Stack (infra + backend + worker + frontend)",
      "configurations": [
        "Backend: FastAPI (uvicorn --reload)",
        "Backend: Worker (app.worker)",
        "Frontend: Vite dev (npm run dev)"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "dev",
        "order": 1
      }
    },
    {
      "name": "Dev: Backend + Worker",
      "configurations": [
        "Backend: FastAPI (uvicorn --reload)",
        "Backend: Worker (app.worker)"
      ],
      "stopAll": true
    }
  ]
}
